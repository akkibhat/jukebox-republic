# Create a Spotify app at https://developer.spotify.com/dashboard to get these.
# Redirect URI must be added to the app's settings there exactly as written here.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/auth/callback

# Base URL guests will actually use to reach this server (your deployed/tunnel URL
# in production; localhost is fine for testing on one machine).
PUBLIC_BASE_URL=http://127.0.0.1:8080

PORT=8080

# Optional: Firestore-backed session survival. Without these, sessions live
# in memory only and a server restart ends every active session. Create a
# Firebase/GCP project with Firestore, make a service account key, then set
# one or both of these. See server/persistence.js for details.
#GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
#FIRESTORE_PROJECT_ID=
